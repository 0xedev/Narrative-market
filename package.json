{
  "name": "narrative-market",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @narrative/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:mechanics": "node scripts/check-mechanics.mjs",
    "testnet:e2e": "node scripts/testnet-e2e.mjs",
    "subgraph:codegen": "pnpm --dir subgraph codegen",
    "subgraph:build": "pnpm --dir subgraph build"
  },
  "devDependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
